; GDownload Inno Setup Script
; 参考 VSCode 的安装体验设计

#define MyAppName "GDownload"
#define MyAppVersion "@APP_VERSION@"
#define MyAppPublisher "GDownload Team"
#define MyAppURL "https://github.com/cool2528/GDownload"
#define MyAppExeName "@EXECUTABLE@"

[Setup]
; 应用程序基本信息
AppId={{A8B9C1D2-E3F4-5678-9ABC-DEF012345678}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
AppUpdatesURL={#MyAppURL}/releases
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}

; 支持系统级和用户级安装（类似 VSCode）
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; 输出配置
OutputDir=@CMAKE_BINARY_DIR@\release
OutputBaseFilename=GDownloader_windows_{#MyAppVersion}
SetupIconFile=@CMAKE_SOURCE_DIR@\src\App\ui\Resource\images\logo\icon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}

; 压缩配置
Compression=lzma2/max
SolidCompression=yes
LZMAUseSeparateProcess=yes
LZMANumBlockThreads=4

; 界面配置
WizardStyle=modern
DisableWelcomePage=no
DisableDirPage=no
DisableProgramGroupPage=yes

; 多语言配置：自动检测系统 UI 语言并直接使用对应语言安装，不弹出语言选择对话框
; 若系统语言不在下方 [Languages] 列表中，则回退使用英语（列表中的第一项）
ShowLanguageDialog=no
LanguageDetectionMethod=uilanguage

; 版本信息
VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName} Setup
VersionInfoCopyright=Copyright (C) 2024 {#MyAppPublisher}

; 架构支持
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; 许可协议（如果存在）
LicenseFile=@CMAKE_SOURCE_DIR@\LICENSE.txt

[Languages]
; 支持的 5 种语言：英语、简体中文、繁体中文、日语、韩语
; 英语/日语/韩语为 Inno Setup 6 自带翻译（compiler: 前缀），简体/繁体中文为项目内置的第三方翻译文件
; ShowLanguageDialog=no + LanguageDetectionMethod=uilanguage 会根据系统 UI 语言自动匹配下方某一项，
; 若系统语言不在此列表中，则回退到列表第一项（英语）
Name: "english";            MessagesFile: "compiler:Default.isl"
Name: "japanese";           MessagesFile: "compiler:Languages\Japanese.isl"
Name: "chinesesimplified";  MessagesFile: "@CMAKE_SOURCE_DIR@\package\languages\ChineseSimplified.isl"
Name: "chinesetraditional"; MessagesFile: "@CMAKE_SOURCE_DIR@\package\languages\ChineseTraditional.isl"
Name: "korean";             MessagesFile: "compiler:Languages\Korean.isl"

[CustomMessages]
; [Tasks] 中两项自定义任务的多语言文案（其余任务描述如 {cm:CreateDesktopIcon} 由 Inno Setup 内置 .isl 提供）
english.AdvancedGroupDescription=Advanced:
chinesesimplified.AdvancedGroupDescription=高级：
chinesetraditional.AdvancedGroupDescription=進階：
japanese.AdvancedGroupDescription=詳細設定：
korean.AdvancedGroupDescription=고급:

english.AddToPathDescription=Add to PATH (allows running from command line)
chinesesimplified.AddToPathDescription=添加到 PATH（允许从命令行运行）
chinesetraditional.AddToPathDescription=加入 PATH（允許從命令列執行）
japanese.AddToPathDescription=PATH に追加する（コマンドラインからの実行が可能になります）
korean.AddToPathDescription=PATH에 추가(명령줄에서 실행 가능)

english.FileAssociationsGroupDescription=File Associations:
chinesesimplified.FileAssociationsGroupDescription=文件关联：
chinesetraditional.FileAssociationsGroupDescription=檔案關聯：
japanese.FileAssociationsGroupDescription=ファイルの関連付け：
korean.FileAssociationsGroupDescription=파일 연결:

english.AssociateTorrentDescription=Associate .torrent files with {#MyAppName}
chinesesimplified.AssociateTorrentDescription=将 .torrent 文件与 {#MyAppName} 建立关联
chinesetraditional.AssociateTorrentDescription=將 .torrent 檔案與 {#MyAppName} 產生關聯
japanese.AssociateTorrentDescription=.torrent ファイルを {#MyAppName} に関連付ける
korean.AssociateTorrentDescription=.torrent 파일을 {#MyAppName}에 연결

; [Code] 中 InitializeSetup 检测到旧版本时弹出的确认框文案（%1 = 旧版本号，运行时通过 FmtMessage 替换）
english.VersionAlreadyInstalledMsg=Version %1 of {#MyAppName} is already installed. Do you want to uninstall it first?
chinesesimplified.VersionAlreadyInstalledMsg={#MyAppName} 的 %1 版本已安装。是否要先将其卸载？
chinesetraditional.VersionAlreadyInstalledMsg={#MyAppName} 的 %1 版本已安裝。是否要先將其解除安裝？
japanese.VersionAlreadyInstalledMsg={#MyAppName} のバージョン %1 は既にインストールされています。先にアンインストールしますか？
korean.VersionAlreadyInstalledMsg={#MyAppName}의 버전 %1이(가) 이미 설치되어 있습니다. 먼저 제거하시겠습니까?

; [Code] 中交互卸载时询问是否一并删除用户数据的确认框文案（升级流程的静默卸载不弹出、不删除）
english.RemoveUserDataMsg=Do you also want to delete user data (settings, download history, and plugin data)? Your downloaded files will not be affected.
chinesesimplified.RemoveUserDataMsg=是否同时删除用户数据（设置、下载记录和插件数据）？已下载的文件不会受影响。
chinesetraditional.RemoveUserDataMsg=是否同時刪除使用者資料（設定、下載記錄與外掛資料）？已下載的檔案不會受到影響。
japanese.RemoveUserDataMsg=ユーザーデータ（設定、ダウンロード履歴、プラグインデータ）も削除しますか？ダウンロード済みのファイルには影響しません。
korean.RemoveUserDataMsg=사용자 데이터(설정, 다운로드 기록, 플러그인 데이터)도 삭제하시겠습니까? 다운로드한 파일은 영향을 받지 않습니다.

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "addtopath"; Description: "{cm:AddToPathDescription}"; GroupDescription: "{cm:AdvancedGroupDescription}"; Flags: unchecked
Name: "associatefiles"; Description: "{cm:AssociateTorrentDescription}"; GroupDescription: "{cm:FileAssociationsGroupDescription}"; Flags: unchecked

[Files]
; 主程序文件
Source: "@INSTALLER_BIN_DIR@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; 排除 PDB 调试文件
Source: "@INSTALLER_BIN_DIR@\*"; DestDir: "{app}"; Excludes: "*.pdb,*.lib,*.exp"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; 开始菜单快捷方式
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
; 桌面快捷方式（可选）
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
; 快速启动栏快捷方式（可选）
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: quicklaunchicon

[Run]
; 安装完成后的操作选项
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Registry]
; 添加卸载信息到注册表
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}"; ValueType: string; ValueName: "DisplayName"; ValueData: "{#MyAppName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}"; ValueType: string; ValueName: "DisplayVersion"; ValueData: "{#MyAppVersion}"
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}"; ValueType: string; ValueName: "Publisher"; ValueData: "{#MyAppPublisher}"
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}"; ValueType: string; ValueName: "DisplayIcon"; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}"; ValueType: string; ValueName: "URLInfoAbout"; ValueData: "{#MyAppURL}"

; 关联 .torrent 文件（可选任务）
Root: HKA; Subkey: "Software\Classes\.torrent"; ValueType: string; ValueName: ""; ValueData: "{#MyAppName}File"; Flags: uninsdeletevalue uninsdeletekeyifempty; Tasks: associatefiles
Root: HKA; Subkey: "Software\Classes\{#MyAppName}File"; ValueType: string; ValueName: ""; ValueData: "{#MyAppName} Torrent File"; Flags: uninsdeletekey; Tasks: associatefiles
Root: HKA; Subkey: "Software\Classes\{#MyAppName}File\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: associatefiles
Root: HKA; Subkey: "Software\Classes\{#MyAppName}File\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associatefiles

[Code]
// 添加到 PATH 环境变量的代码
procedure CurStepChanged(CurStep: TSetupStep);
var
  Path: string;
  AppPath: string;
begin
  if (CurStep = ssPostInstall) and WizardIsTaskSelected('addtopath') then
  begin
    AppPath := ExpandConstant('{app}');

    // 根据安装权限选择注册表位置
    if IsAdminInstallMode then
    begin
      RegQueryStringValue(HKEY_LOCAL_MACHINE, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', Path);
      if Pos(AppPath, Path) = 0 then
      begin
        Path := Path + ';' + AppPath;
        RegWriteStringValue(HKEY_LOCAL_MACHINE, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', Path);
      end;
    end
    else
    begin
      RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path);
      if Pos(AppPath, Path) = 0 then
      begin
        Path := Path + ';' + AppPath;
        RegWriteStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path);
      end;
    end;
  end;
end;

// 交互卸载时是否一并删除用户数据(在 usUninstall 阶段询问,usPostUninstall 阶段执行)
var
  RemoveUserData: Boolean;

// 删除应用的用户数据与注册表足迹。
// 只清配置/历史/插件数据,绝不触碰用户下载目录里的文件。
procedure DeleteUserDataAndSettings();
begin
  // GDLCore 数据目录:gd.toml 配置、下载历史 db、logs、aria2 session、ed2k 数据
  DelTree(ExpandConstant('{userappdata}\gdownload'), True, True, True);
  // Qt AppDataLocation(org=gdl/app=gdownload):插件 storage/cookies 等
  DelTree(ExpandConstant('{userappdata}\gdl\gdownload'), True, True, True);
  // 组织目录仅在为空时移除,避免误删同组织其他应用的数据
  RemoveDir(ExpandConstant('{userappdata}\gdl'));
  // QSettings(NativeFormat)注册表:更新检查时间、目录历史等
  RegDeleteKeyIncludingSubkeys(HKEY_CURRENT_USER, 'Software\gdl\gdownload');
  RegDeleteKeyIfEmpty(HKEY_CURRENT_USER, 'Software\gdl');
end;

// 卸载时从 PATH 移除
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Path: string;
  AppPath: string;
  P: Integer;
begin
  // 交互卸载开始前询问是否删除用户数据(默认"否")。
  // 升级流程通过 /SILENT 静默卸载旧版本,UninstallSilent 为 True,
  // 此时既不弹窗也不删除,保证升级不丢配置。
  if CurUninstallStep = usUninstall then
  begin
    RemoveUserData := False;
    if not UninstallSilent then
    begin
      if MsgBox(CustomMessage('RemoveUserDataMsg'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
        RemoveUserData := True;
    end;
  end;

  if CurUninstallStep = usPostUninstall then
  begin
    // 真卸载(非升级)时无条件移除开机自启注册表值,避免残留项指向已删除的程序;
    // 升级的静默卸载保留该值,使用户的自启设置在新版本中延续
    if not UninstallSilent then
      RegDeleteValue(HKEY_CURRENT_USER, 'Software\Microsoft\Windows\CurrentVersion\Run', 'gdownload');

    if RemoveUserData then
      DeleteUserDataAndSettings();

    AppPath := ExpandConstant('{app}');

    // 从系统 PATH 移除
    if RegQueryStringValue(HKEY_LOCAL_MACHINE, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', Path) then
    begin
      P := Pos(';' + AppPath, Path);
      if P = 0 then
        P := Pos(AppPath + ';', Path);
      if P > 0 then
      begin
        Delete(Path, P, Length(AppPath) + 1);
        RegWriteStringValue(HKEY_LOCAL_MACHINE, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', Path);
      end;
    end;

    // 从用户 PATH 移除
    if RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path) then
    begin
      P := Pos(';' + AppPath, Path);
      if P = 0 then
        P := Pos(AppPath + ';', Path);
      if P > 0 then
      begin
        Delete(Path, P, Length(AppPath) + 1);
        RegWriteStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path);
      end;
    end;
  end;
end;

// 检测旧版本
function InitializeSetup(): Boolean;
var
  OldVersion: string;
  UninstallPath: string;
  ResultCode: Integer;
begin
  Result := True;

  // 检查是否已安装
  if RegQueryStringValue(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}', 'UninstallString', UninstallPath) or
     RegQueryStringValue(HKEY_CURRENT_USER, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}', 'UninstallString', UninstallPath) then
  begin
    if RegQueryStringValue(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}', 'DisplayVersion', OldVersion) or
       RegQueryStringValue(HKEY_CURRENT_USER, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}', 'DisplayVersion', OldVersion) then
    begin
      if MsgBox(FmtMessage(CustomMessage('VersionAlreadyInstalledMsg'), [OldVersion]), mbConfirmation, MB_YESNO) = IDYES then
      begin
        // 静默卸载旧版本
        Exec(RemoveQuotes(UninstallPath), '/SILENT', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
      end
      else
      begin
        Result := False;
      end;
    end;
  end;
end;
