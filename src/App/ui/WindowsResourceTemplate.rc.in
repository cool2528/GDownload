#include <windows.h>
IDI_ICON1 ICON "Resource/images/logo/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ${CURRENT_VERSION_MAJOR}, ${CURRENT_VERSION_MINOR}, ${CURRENT_VERSION_BUILD}, ${CURRENT_VERSION_COMMIT}
PRODUCTVERSION ${CURRENT_VERSION_MAJOR}, ${CURRENT_VERSION_MINOR}, ${CURRENT_VERSION_BUILD}, ${CURRENT_VERSION_COMMIT}
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4" 
        BEGIN
            VALUE "CompanyName", "${PROJECT_NAME}"
            VALUE "FileDescription", "${PROJECT_NAME}"
            VALUE "FileVersion", "${CURRENT_VERSION_MAJOR}.${CURRENT_VERSION_MINOR}.${CURRENT_VERSION_BUILD}.${CURRENT_VERSION_COMMIT}"
            VALUE "InternalName", "${PROJECT_NAME}"
            VALUE "OriginalFilename", "${PROJECT_NAME}.exe"
            VALUE "ProductName", "${PROJECT_NAME}"
            VALUE "ProductVersion", "${CURRENT_VERSION_MAJOR}.${CURRENT_VERSION_MINOR}.${CURRENT_VERSION_BUILD}.${CURRENT_VERSION_COMMIT}"
            VALUE "LegalCopyright", "Copyright (C) 2025 My Company"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
