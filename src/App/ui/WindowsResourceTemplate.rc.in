#include <windows.h>
IDI_ICON1 ICON "Resource/images/logo/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ${CURRENT_VERSION_MAJOR}, ${CURRENT_VERSION_MINOR}, ${CURRENT_VERSION_BUILD}
PRODUCTVERSION ${CURRENT_VERSION_MAJOR}, ${CURRENT_VERSION_MINOR}, ${CURRENT_VERSION_BUILD}
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4" 
        BEGIN
            VALUE "CompanyName", "${PRODUCT_COMPANY_NAME}"
            VALUE "FileDescription", "${PRODUCT_DISPLAY_NAME} - Modern Download Manager"
            VALUE "FileVersion", "${CURRENT_VERSION_MAJOR}.${CURRENT_VERSION_MINOR}.${CURRENT_VERSION_BUILD}.${CURRENT_VERSION_COMMIT}"
            VALUE "InternalName", "${PROJECT_NAME}"
            VALUE "OriginalFilename", "${PROJECT_NAME}.exe"
            VALUE "ProductName", "${PRODUCT_DISPLAY_NAME}"
            VALUE "ProductVersion", "${APP_VERSION}"
            VALUE "LegalCopyright", "${PRODUCT_COPYRIGHT}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
